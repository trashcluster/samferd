# Core settings
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://samferd:samferd@db:5432/samferd
REDIS_URL=redis://redis:6379/0

# Language
DEFAULT_LANGUAGE=fr

# Auth
ENABLE_PASSWORD_AUTH=true
# Optional OIDC provider
OIDC_RP_CLIENT_ID=
OIDC_RP_CLIENT_SECRET=
OIDC_OP_DISCOVERY_URL=

# Fare provider (amadeus)
FARE_PROVIDER=amadeus
AMADEUS_ENV=test
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
API_MONTHLY_BUDGET=2000

# Notifications (email)
EMAIL_URL=smtp://user:pass@smtp.example.com:587/?ssl=true
DEFAULT_FROM_EMAIL=samferd@example.com

# Better-route comparison
TIE_TOLERANCE_PERCENT=5