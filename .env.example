# Samferd — environment variables (example).
#
# Copy this file to `.env` if you use a local env loader, BUT the recommended
# (and secure) way is to set these as Cloudflare Worker secrets instead:
#
#   wrangler secret put BOT_TOKEN
#   wrangler secret put GROUP_ID
#
# Secrets set that way are encrypted in Cloudflare and never written to disk,
# so you do NOT need a local .env for production. This file exists only to
# document every key the project needs and to support local `wrangler dev`
# testing (via a `.dev.vars` file, which is git-ignored).

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Telegram bot API token, from @BotFather when you ran /newbot.
# Format: <numeric-id>:<secret>, e.g. 1234567890:AAH...
BOT_TOKEN=

# The group/supergroup chat id users must belong to. Negative for groups.
# Get it by adding @RawDataBot to the group and reading the chat "id".
# Example: -1001234567890
GROUP_ID=

# ---------------------------------------------------------------------------
# Optional — flight-data enrichment (DISABLED by default; leave blank to skip)
# ---------------------------------------------------------------------------

# Which flight API provider to use. Leave empty or 'none' to disable enrichment.
# Only 'aviationstack' is currently recognized (see backend/worker.js).
# The API is called ONLY the first time a flight number is entered; the result
# is cached in KV and reused for every later flight with the same number.
FLIGHT_API_PROVIDER=aviationstack

# API key for the provider above. Only needed if FLIGHT_API_PROVIDER is set.
# Get a free key at https://aviationstack.com/signup/free
FLIGHT_API_KEY=

# ---------------------------------------------------------------------------
# Frontend settings (not secrets — these live in miniapp/app.js, not env)
# ---------------------------------------------------------------------------
# Documented here for completeness; edit the values directly in app.js:
#   API               -> your Cloudflare Worker URL (https://<name>.<sub>.workers.dev)
#   GROUP_INVITE_LINK -> the group's invite link shown to non-members (https://t.me/+...)
